# Swaylock Config - Pure Black Minimalist Theme

image=/home/guts/Pictures/Wallpapers/wallpaper.png
scaling=fill
effect-blur=7x5

# Clock Display
clock
timestr=%I:%M %p
datestr=%A, %B %d
font=Inter

# Indicator
indicator
indicator-radius=100
indicator-thickness=8

# Base Colors (Pitch Black Glass with Crisp White Outline)
inside-color=000000dd
ring-color=ffffffff
text-color=ffffffff
line-color=00000000
separator-color=00000000

# Typing & Backspace Feedback
key-hl-color=8892a0ff
bs-hl-color=e06c75ff

# Verification / Correct Password (Green)
ring-ver-color=4caf50ff
inside-ver-color=000000dd
text-ver-color=4caf50ff

# Wrong Password (Red)
ring-wrong-color=e53935ff
inside-wrong-color=000000dd
text-wrong-color=e53935ff

# Cleared (Yellow)
ring-clear-color=e5c07bff
inside-clear-color=000000dd
text-clear-color=e5c07bff
