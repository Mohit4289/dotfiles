// -*- mode: jsonc -*-
{
  "height": 38,
  "spacing": 6,

  "modules-left": [
    "custom/launcher",
    "sway/workspaces",
    "idle_inhibitor"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "pulseaudio",
    "custom/mic",
    "cpu",
    "memory",
    "backlight",
    "temperature",
    "power-profiles-daemon",
    "battery",
    "tray",
    "custom/power"
  ],

  // ─────────────────────────────────────
  // Workspaces
  // ─────────────────────────────────────

  "sway/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true,
    "disable-scroll": true
  },

  // ─────────────────────────────────────
  // Idle inhibitor
  // ─────────────────────────────────────

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip-format-activated": "Idle inhibitor: ON",
    "tooltip-format-deactivated": "Idle inhibitor: OFF"
  },

  // ─────────────────────────────────────
  // System tray
  // ─────────────────────────────────────

  "tray": {
    "spacing": 10
  },

  // ─────────────────────────────────────
  // Clock
  // ─────────────────────────────────────

  "clock": {
    "format": "{:%a %d %b  %I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  // ─────────────────────────────────────
  // CPU
  // ─────────────────────────────────────

  "cpu": {
    "interval": 5,
    "format": "  {usage}%",
    "tooltip": true,
    "tooltip-format": "CPU Usage: {usage}%",
    "on-click": "kitty -e btop"
  },

  // ─────────────────────────────────────
  // Memory
  // ─────────────────────────────────────

  "memory": {
    "interval": 5,
    "format": "  {}%",
    "tooltip": true,
    "tooltip-format": "Memory Usage: {}%",
    "on-click": "kitty -e btop"
  },

  // ─────────────────────────────────────
  // Temperature
  // ─────────────────────────────────────

  "temperature": {
    "interval": 5,
    "critical-threshold": 80,
    "format": "{icon}  {temperatureC}°C",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip": true
  },

  // ─────────────────────────────────────
  // Brightness
  // ─────────────────────────────────────

  "backlight": {
    "format": "{icon}  {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%"
  },

  // ─────────────────────────────────────
  // Battery
  // ─────────────────────────────────────

 "battery": {
   "states": {
     "warning": 50,
     "critical": 35
   },
   "format": "{icon}  {capacity}%",
   "format-full": "{icon}  {capacity}%",
   "format-charging": "󱐋 {icon} {capacity}%",
   "format-plugged": " {icon} {capacity}%",
   "format-alt": "{icon}  {time}",
   "format-icons": [
     "󰁺",
     "󰁻",
     "󰁼",
     "󰁼",
     "󰁽",
     "󰁾",
     "󰁿",
     "󰂀",
     "󰂁",
     "󰂂",
     "󰁹"
   ]
   },

  // ─────────────────────────────────────
  // Power profile
  // ─────────────────────────────────────

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip": true,
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",

    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },

  // ─────────────────────────────────────
  // Network
  // ─────────────────────────────────────

  "network": {
    "interval": 5,

    "format-wifi": "{icon}  {essid} ({signalStrength}%)",
    "format-ethernet": "󰈀  {ipaddr}/{cidr}",
    "format-linked": "󰈀  {ifname}",
    "format-disconnected": "󰤭",

    "format-alt": "{ifname}: {ipaddr}/{cidr}",

    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],

    "tooltip": true,

    "tooltip-format": "  Interface  :  {ifname}\n\n󱂇  Gateway    :  {gwaddr}\n\n󰓅  Bandwidth  :  ▼{bandwidthDownBytes} |  ▲{bandwidthUpBytes}",

    "on-click": "nm-connection-editor"
  },

  // ─────────────────────────────────────
  // Sound / Headphone Output (Sound Only)
  // ─────────────────────────────────────

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": "{icon}󰂯  {volume}%",
    "format-bluetooth-muted": "󰝟󰂯  muted",
    "format-muted": "󰝟  muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 5,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },

  // ─────────────────────────────────────
  // Microphone Input (Mic Only)
  // ─────────────────────────────────────

  "custom/mic": {
    "format": "{}",
    "return-type": "json",
    "exec": "/home/guts/.config/waybar/scripts/mic.sh",
    "interval": 1,
    "signal": 10,
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle && pkill -RTMIN+10 waybar",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5% && pkill -RTMIN+10 waybar",
    "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5% && pkill -RTMIN+10 waybar"
  },

  "custom/power": {
    "format": "⏻ ",
    "on-click": "wlogout -b 6 -c 16 -r 16 -T 430 -B 430 -L 260 -R 260",
    "tooltip": false
  },

  // ─────────────────────────────────────
  // Arch launcher
  // ─────────────────────────────────────

  "custom/launcher": {
    "format": "    ",
    "on-click": "fuzzel",
    "tooltip": false
  },

  // ─────────────────────────────────────
  // Waybar signals
  // ─────────────────────────────────────

  "on-sigusr1": "hide",
  "on-sigusr2": "show"
}
